# ---------------------------------------------------------------------------
# VR Control Center - environment template
# Copy to `.env` and adjust. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Local gateway ---------------------------------------------------------
# Bind on all LAN interfaces so Quest headsets can reach the PC.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=4000
# The dashboard origin allowed to call the gateway (dev server).
ADMIN_ORIGIN=http://localhost:3000
# Optional extra allowed origins, comma separated (e.g. http://192.168.1.100:4000)
EXTRA_ALLOWED_ORIGINS=
# Public base URL of the gateway as reachable from headsets. Leave blank to
# auto-detect the primary LAN IPv4 address at startup.
PUBLIC_GATEWAY_URL=
# To enable WSS/HTTPS, set both paths and use https:// URLs above.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Trust X-Forwarded-* only when you actually run behind a reverse proxy.
TRUST_PROXY=false

# --- Local persistence -----------------------------------------------------
DATA_DIR=./storage/data
VIDEO_DIR=./storage/videos
THUMBNAIL_DIR=./storage/thumbnails
TEMP_DIR=./storage/temp
LOG_DIR=./storage/logs
LOG_LEVEL=info

# --- Operational tuning ----------------------------------------------------
HEARTBEAT_INTERVAL_MS=5000
OFFLINE_THRESHOLD_MS=18000
COMMAND_TIMEOUT_MS=6000
PAIRING_TTL_SECONDS=180
PAIRING_MAX_ATTEMPTS=5
ADMIN_SESSION_TTL_HOURS=12
RETENTION_DAYS=30
PREVIEW_MAX_FPS=12
PREVIEW_MAX_JPEG_BYTES=250000
MAX_VIDEO_UPLOAD_BYTES=21474836480
MAX_CONCURRENT_DOWNLOADS_PER_DEVICE=1

# --- FFmpeg (optional; enables metadata inspection & transcoding) ----------
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
FFPROBE_TIMEOUT_MS=20000

# --- First-run / CLI admin bootstrap (optional) ----------------------------
# If both are set, `npm run admin:create` provisions/updates a local admin
# without prompting. Omit to use the one-time browser setup on localhost.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

```gitignore
node_modules/
dist/
dist-electron/
build/
coverage/
playwright-report/
test-results/
blob-report/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Environment & secrets
.env
.env.local
.env.*.local
!.env.example

# TLS certificates and private keys
server.key
server.crt
certs/
*.pem
*.key

# Local runtime state
storage/videos/*
!storage/videos/.gitkeep
storage/thumbnails/*
!storage/thumbnails/.gitkeep
storage/temp/*
!storage/temp/.gitkeep
storage/data/*
!storage/data/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/bootstrap-admin.txt
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Supabase local development
supabase/.branches
supabase/.temp

# Unity
apps/quest/UnityProject/[Ll]ibrary/
apps/quest/UnityProject/[Tt]emp/
apps/quest/UnityProject/[Oo]bj/
apps/quest/UnityProject/[Bb]uild/
apps/quest/UnityProject/[Bb]uilds/
apps/quest/UnityProject/[Ll]ogs/
apps/quest/UnityProject/[Uu]ser[Ss]ettings/
apps/quest/UnityProject/[Mm]emoryCaptures/
apps/quest/UnityProject/[Rr]ecordings/
apps/quest/UnityProject/Logs/
apps/quest/UnityProject/*.csproj
apps/quest/UnityProject/*.sln
apps/quest/UnityProject/*.apk
apps/quest/UnityProject/*.aab
apps/quest/UnityProject/.vs/
apps/quest/UnityProject/.idea/
apps/quest/UnityProject/Assets/Plugins/Android/*.aar
apps/quest/UnityProject/Assets/Plugins/Android/*.jar
*.unitypackage
*.apk
*.aab
*.keystore
*.jks
keystore.properties

# OS / editors
.vscode/*
!.vscode/extensions.json
.idea/
```